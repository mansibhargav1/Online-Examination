# Copy this file to `.env` in the same folder and fill in your values.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# Docker Compose reads `.env` from the project root automatically.

# Turn email on. Leave false and the app works normally — credentials just
# stay in the admin console instead of being mailed out.
MAIL_ENABLED=true

# ---------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------
# 1. Turn on 2-Step Verification on your Google account.
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character string below — NOT your Gmail password.
# Gmail rewrites the sender, so MAIL_FROM must equal SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=youraddress@gmail.com

# ---------------------------------------------------------------
# Resend — better deliverability, needs a verified domain
# ---------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key
# MAIL_FROM=noreply@yourdomain.com

# ---------------------------------------------------------------
# Brevo
# ---------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# MAIL_FROM=youraddress@yourdomain.com

# The sign-in link inside the email. Change when you deploy.
PORTAL_URL=http://localhost:8080
